@startuml Diagramme_Cas_Utilisation_Presences

title Systeme de Gestion des Presences\nDiagramme de Cas d'Utilisation

top to bottom direction
skinparam packageStyle rectangle
skinparam actorStyle awesome
skinparam usecase {
    BackgroundColor #FEFECE
    BorderColor #A80036
    ArrowColor #A80036
}
skinparam actor {
    BackgroundColor #FEFECE
    BorderColor #A80036
}

' -------------------------------------------
' ACTEURS (hors systeme)
' -------------------------------------------

' Acteur parent abstrait
actor "Utilisateur" as Utilisateur

' Acteurs concrets - heritent de Utilisateur
actor "Etudiant" as Etudiant
actor "Enseignant" as Enseignant
actor "Administrateur" as Admin

Etudiant   --|> Utilisateur
Enseignant --|> Utilisateur
Admin      --|> Utilisateur

' -------------------------------------------
' SYSTEME
' -------------------------------------------
rectangle "Systeme de Gestion des Presences" {

    ' Cas commun a tous les utilisateurs
    usecase "S'authentifier" as UC_Auth

    ' Cas de l'Etudiant
    usecase "Scanner le code QR" as UC_Scan
    usecase "Enregistrer la presence" as UC_Enreg
    usecase "Consulter les presences" as UC_Consult
    usecase "Justifier une absence" as UC_Justif
    usecase "Recevoir des notifications" as UC_Notif

    ' Cas de l'Enseignant
    usecase "Generer le code QR" as UC_GenQR
    usecase "Prendre les presences" as UC_Prise
    usecase "Consulter les statistiques" as UC_Stats

    ' Cas de l'Administrateur
    usecase "Gerer les utilisateurs" as UC_Users
    usecase "Gerer les cours" as UC_Cours
    usecase "Generer des rapports" as UC_Rapports

    ' Relations entre cas d'utilisation
    UC_Scan ..> UC_Enreg : <<include>>
    UC_Notif ..> UC_Justif : <<extend>>
}

' -------------------------------------------
' ASSOCIATIONS acteurs - cas d'utilisation
' -------------------------------------------

' Tous les utilisateurs s'authentifient (via l'acteur parent)
Utilisateur --> UC_Auth

' Etudiant
Etudiant --> UC_Scan
Etudiant --> UC_Consult
Etudiant --> UC_Justif
Etudiant --> UC_Notif

' Enseignant
Enseignant --> UC_GenQR
Enseignant --> UC_Prise
Enseignant --> UC_Consult
Enseignant --> UC_Stats
Enseignant --> UC_Notif

' Administrateur
Admin --> UC_Users
Admin --> UC_Cours
Admin --> UC_Rapports
Admin --> UC_Stats

@enduml

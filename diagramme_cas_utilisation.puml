@startuml Diagramme_Cas_Utilisation_Presences

title Système de Gestion des Présences\nDiagramme de Cas d'Utilisation

top to bottom direction
skinparam packageStyle rectangle
skinparam actorStyle awesome
skinparam usecase {
    BackgroundColor #FEFECE
    BorderColor #A80036
    ArrowColor #A80036
}
skinparam actor {
    BackgroundColor #FEFECE
    BorderColor #A80036
}

' ===========================================
' ACTEURS (hors système)
' ===========================================

' Acteur parent abstrait
actor "Utilisateur" as Utilisateur

' Acteurs concrets — héritent de Utilisateur
actor "Étudiant"       as Etudiant
actor "Enseignant"     as Enseignant
actor "Administrateur" as Admin

Etudiant   --|> Utilisateur
Enseignant --|> Utilisateur
Admin      --|> Utilisateur

' ===========================================
' SYSTÈME
' ===========================================
rectangle "Système de Gestion des Présences" {

    ' --- Cas commun à tous les utilisateurs ---
    usecase "S'authentifier" as UC_Auth

    ' --- Cas de l'Étudiant ---
    usecase "Scanner le code QR"        as UC_Scan
    usecase "Enregistrer la présence"   as UC_Enreg
    usecase "Consulter les présences"   as UC_Consult
    usecase "Justifier une absence"     as UC_Justif
    usecase "Recevoir des notifications" as UC_Notif

    ' --- Cas de l'Enseignant ---
    usecase "Générer le code QR"         as UC_GenQR
    usecase "Prendre les présences"      as UC_Prise
    usecase "Consulter les statistiques" as UC_Stats

    ' --- Cas de l'Administrateur ---
    usecase "Gérer les utilisateurs" as UC_Users
    usecase "Gérer les cours"        as UC_Cours
    usecase "Générer des rapports"   as UC_Rapports

    ' --- Relations entre cas d'utilisation ---

    ' <<include>> : Scanner le code QR inclut toujours Enregistrer la présence
    ' (la flèche part du cas de base vers le cas inclus)
    UC_Scan ..> UC_Enreg : <<include>>

    ' <<extend>> : Recevoir des notifications est optionnel,
    ' déclenché lors d'une justification d'absence
    UC_Notif ..> UC_Justif : <<extend>>
}

' ===========================================
' ASSOCIATIONS acteurs <-> cas d'utilisation
' ===========================================

' Tous les utilisateurs s'authentifient (via l'acteur parent)
Utilisateur --> UC_Auth

' Étudiant
Etudiant --> UC_Scan
Etudiant --> UC_Consult
Etudiant --> UC_Justif
Etudiant --> UC_Notif

' Enseignant
Enseignant --> UC_GenQR
Enseignant --> UC_Prise
Enseignant --> UC_Consult
Enseignant --> UC_Stats
Enseignant --> UC_Notif

' Administrateur
Admin --> UC_Users
Admin --> UC_Cours
Admin --> UC_Rapports
Admin --> UC_Stats

@enduml
